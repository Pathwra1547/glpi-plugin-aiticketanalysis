# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
~$*
.idea/
.vscode/
*.sublime-*

# Backups and patch leftovers — must never reach a release archive
*.bak
*.orig
*.rej
*.tmp
*.log

# Local build / dependency directories
node_modules/
vendor/
composer.lock
package-lock.json

# Local configuration and secrets: never commit real URLs, tokens or workspace slugs
.env
.env.*
*.local.php
config.local.*
anythingllm_mcp_servers.json

# Local prompts and knowledge base extracts
prompts/*.local.txt
docs/*.internal.*
